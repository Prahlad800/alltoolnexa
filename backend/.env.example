# Supabase dashboard > Connect > Session pooler > URI (port 5432).
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Use demo for a loopback-only preview without any database connection.
AUTH_MODE=database
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@alltoolnexa.local
# Required only with AUTH_MODE=demo; choose at least 12 characters.
DEMO_ADMIN_PASSWORD=

# Generate a private random key of at least 32 bytes; never use NEXT_PUBLIC_.
JWT_SECRET_KEY=
# Production origins only; local loopback origins are the demo defaults.
# AUTH_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
# AUTH_COOKIE_SECURE=true

# Trust forwarded IP/proto only behind this exact number of controlled proxies.
TRUSTED_PROXY_HOPS=0
