# Public production origin for canonical URLs and the sitemap.
# Local development defaults to http://localhost:3000 when this is unset.
NEXT_PUBLIC_SITE_URL=https://alltoolnexa.pages.dev
# Optional contact address, displayed on the Contact page. Leave unset until configured.
NEXT_PUBLIC_CONTACT_EMAIL=

# Live API; override only when using a different backend.
NEXT_PUBLIC_API_URL=https://prahlad800.pythonanywhere.com
# For local API development, replace the value above with http://localhost:5000.
